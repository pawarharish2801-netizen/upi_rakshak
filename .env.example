# ==============================================================================
# UPI Rakshak — Environment Configuration Template
# Copy this file to .env (or configure in your deployment platform)
# ==============================================================================

# Backend Server Host & Port
HOST=127.0.0.1
PORT=8000

# Allowed CORS Origins (Comma-separated, OWASP API8 / CWE-942 Compliance)
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000,http://127.0.0.1:3000

# Optional: Persistent Storage (MongoDB Atlas connection string)
# Leave blank to use bounded in-memory audit store
MONGODB_URI=

# Optional: TypeSafe AI Jev Decision Engine
# If left blank, UPI Rakshak automatically uses its local calibrated decision engine
TYPESAFE_API_KEY=
JEV_API_URL=https://api.typesafe.ai/v1/decide

# Frontend API URL (for Vite build/preview)
# Default is /api (proxied via Vite dev server)
VITE_API_BASE=/api

